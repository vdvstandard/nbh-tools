{{ 'section-lookbook-viewer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lookbook-viewer.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign total_slides = section.blocks.size
  assign title = page.title | default: 'Lookbook'
  assign index_label = section.settings.index_label | default: 'INDEX'

  assign total_slides_display = total_slides

  if total_slides < 10
    assign total_slides_display = total_slides | prepend: '0'
  endif
-%}

<lookbook-viewer
  class="lookbook-viewer color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
  data-lookbook-season-label="{{ section.settings.season_label | escape }}"
  data-lookbook-active="false"
>
  {%- if total_slides > 0 -%}
    <div class="lookbook-viewer__stage" data-lookbook-stage tabindex="-1">
      <div class="lookbook-viewer__top">
        <div class="lookbook-viewer__season-menu" data-lookbook-season-menu>
  <button
    class="lookbook-viewer__season-button"
    type="button"
    data-lookbook-season-button
    aria-haspopup="menu"
    aria-expanded="false"
    style="display:none"
  >
    <span data-lookbook-season-current>{{ section.settings.season_label | escape }}</span>
  </button>
  <ul class="lookbook-viewer__season-list lookbook-viewer__season-sidebar" data-lookbook-season-list role="menu"></ul>
</div>
{%- if section.settings.slogan != blank -%}
  <p class="lookbook-viewer__slogan">{{ section.settings.slogan | escape }}</p>
{%- endif -%}
      </div>

      <div class="lookbook-viewer__slides" aria-label="{{ title | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign image = block.settings.image
            assign image_alt = block.settings.alt_text | default: image.alt | default: title
            assign fetchpriority = 'auto'

            if forloop.index0 == 0
              assign fetchpriority = 'high'
            endif
          -%}

          <div
            class="lookbook-viewer__slide{% if forloop.first %} is-active{% endif %}"
            data-lookbook-slide
            data-index="{{ forloop.index0 }}"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 2400
                | image_tag:
                  widths: '750, 990, 1200, 1500, 1800, 2200, 2400',
                  sizes: '(max-width: 749px) calc(100vw - 2.8rem), 66rem',
                  class: 'lookbook-viewer__image',
                  alt: image_alt,
                  loading: 'eager',
                  fetchpriority: fetchpriority
              }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="lookbook-viewer__bottom">
        <p class="lookbook-viewer__counter" data-lookbook-counter aria-hidden="true">01 | {{ total_slides_display }}</p>
        <button class="lookbook-viewer__index-button" type="button" data-lookbook-index>
          {{ index_label | escape }}
        </button>
      </div>

      <div class="lookbook-viewer__thumb-strip" data-lookbook-strip>
        <ul class="lookbook-viewer__thumb-list" role="list" aria-label="{{ index_label | escape }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign image = block.settings.image
              assign image_alt = block.settings.alt_text | default: image.alt | default: title
            -%}
            <li class="lookbook-viewer__thumb-item">
              <button
                class="lookbook-viewer__thumb"
                type="button"
                data-lookbook-thumb="{{ forloop.index0 }}"
                aria-label="{{ title | escape }} {{ forloop.index }} / {{ total_slides }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                {%- if image != blank -%}
                  {{
                    image
                    | image_url: width: 240
                    | image_tag:
                      widths: '120, 180, 240',
                      sizes: '120px',
                      alt: image_alt,
                      loading: 'lazy'
                  }}
                {%- endif -%}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>

    <div class="lookbook-viewer__drawer" data-lookbook-drawer aria-hidden="true">
      <div class="lookbook-viewer__drawer-header">
        <p class="lookbook-viewer__drawer-title">{{ index_label | escape }}</p>
        <button class="lookbook-viewer__drawer-close" type="button" data-lookbook-close aria-label="Close index">
          &times;
        </button>
      </div>
      <ul class="lookbook-viewer__thumb-list" role="list" aria-label="{{ index_label | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign image = block.settings.image
            assign image_alt = block.settings.alt_text | default: image.alt | default: title
          -%}
          <li class="lookbook-viewer__thumb-item">
            <button
              class="lookbook-viewer__thumb"
              type="button"
              data-lookbook-thumb="{{ forloop.index0 }}"
              aria-label="{{ title | escape }} {{ forloop.index }} / {{ total_slides }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 240
                  | image_tag:
                    widths: '120, 180, 240',
                    sizes: '120px',
                    alt: image_alt,
                    loading: 'lazy'
                }}
              {%- endif -%}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <span class="visually-hidden" aria-live="polite" data-lookbook-live>01 | {{ total_slides_display }}</span>
  {%- else -%}
    <div class="lookbook-viewer__empty">
      <p>Add image blocks to build this lookbook.</p>
    </div>
  {%- endif -%}
</lookbook-viewer>

{% schema %}
{
  "name": "Lookbook viewer",
  "tag": "section",
  "class": "section section-lookbook-viewer",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
"settings": [
  {
    "type": "text",
    "id": "slogan",
    "label": "Slogan / tekst linksboven",
    "default": "IDENTITY LOOKS"
  },
  {
    "type": "paragraph",

      "content": "Upload multiple images in Shopify Files first, then add and reorder image blocks here to control the lookbook order."
    },
    {
      "type": "text",
      "id": "season_label",
      "label": "Season label",
      "default": "SPRING 2026"
    },
    {
      "type": "text",
      "id": "index_label",
      "label": "Index label",
      "default": "INDEX"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook viewer"
    }
  ]
}
{% endschema %}
