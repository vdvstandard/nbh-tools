<section class="split-hero" id="split-hero-{{ section.id }}">
  <div class="split-hero__sticky">
    <div class="split-hero__media">
      {% for block in section.blocks %}
        <div
          class="split-hero__image-layer{% if forloop.first %} is-base{% endif %}"
          data-image-layer
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.button_link != blank %}
            <a href="{{ block.settings.button_link }}" class="split-hero__image-link" aria-label="{{ block.settings.heading | escape }}">
          {% endif %}

          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 2800
              | image_tag:
                class: 'split-hero__image',
                loading: 'lazy',
                alt: block.settings.heading
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'split-hero__image split-hero__placeholder' }}
          {% endif %}

          {% if block.settings.button_link != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
      <div class="split-hero__overlay"></div>
    </div>

    <div class="split-hero__content-wrap">
      {% for block in section.blocks %}
        {% assign content_tag = 'div' %}
        {% if block.settings.button_link != blank %}
          {% assign content_tag = 'a' %}
        {% endif %}

        <{{ content_tag }}
          {% if content_tag == 'a' %}href="{{ block.settings.button_link }}"{% endif %}
          class="split-hero__content{% if forloop.first %} is-active{% endif %}{% if content_tag == 'a' %} split-hero__content-link{% endif %}"
          data-content
          data-index="{{ forloop.index0 }}"
        >
          {% if block.settings.eyebrow != blank %}
            <div class="split-hero__eyebrow">{{ block.settings.eyebrow }}</div>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="split-hero__heading">{{ block.settings.heading }}</h2>
          {% endif %}

          {% if block.settings.button_label != blank and block.settings.button_link != blank %}
            <span class="split-hero__button">
              {{ block.settings.button_label }}
            </span>
          {% endif %}
        </{{ content_tag }}>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #split-hero-{{ section.id }} {
    position: relative;
    height: calc(100vh * {{ section.blocks.size }});
  }

  #split-hero-{{ section.id }} .split-hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  #split-hero-{{ section.id }} .split-hero__media {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #111;
  }

  #split-hero-{{ section.id }} .split-hero__image-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    clip-path: inset(100% 0 0 0);
    will-change: clip-path;
  }

  #split-hero-{{ section.id }} .split-hero__image-layer.is-base {
    clip-path: inset(0 0 0 0);
    z-index: 1;
  }

  #split-hero-{{ section.id }} .split-hero__image,
  #split-hero-{{ section.id }} .split-hero__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #split-hero-{{ section.id }} .split-hero__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  #split-hero-{{ section.id }} .split-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.14);
    pointer-events: none;
    z-index: 20;
  }

  #split-hero-{{ section.id }} .split-hero__content-wrap {
    position: absolute;
    inset: 0;
    z-index: 30;
  }

#split-hero-{{ section.id }} .split-hero__content {
  position: absolute;
  inset: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.22s linear, visibility 0.22s linear;
  pointer-events: none;
}


  #split-hero-{{ section.id }} .split-hero__content.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  #split-hero-{{ section.id }} .split-hero__content-link {
    text-decoration: none;
    color: inherit;
  }

  #split-hero-{{ section.id }} .split-hero__content-link:hover {
    text-decoration: none;
  }


  #split-hero-{{ section.id }} .split-hero__eyebrow,
  #split-hero-{{ section.id }} .split-hero__heading {
    color: {{ section.settings.text_color }} !important;
  }

  #split-hero-{{ section.id }} .split-hero__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #split-hero-{{ section.id }} .split-hero__heading {
    margin: 0;
    font-size: clamp(2.1rem, 5.2vw, 4.3rem);
    line-height: 1;
    font-weight: 400;
    text-align: center;
    max-width: 100%;
  }

  #split-hero-{{ section.id }} .split-hero__button {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 12px 28px;
    background: transparent;
    border: 1px solid {{ section.settings.text_color }};
    color: {{ section.settings.text_color }} !important;
    text-decoration: none;
    font-size: 0.85rem;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  #split-hero-{{ section.id }} .split-hero__button:hover {
    background: {{ section.settings.text_color }};
    color: #000000 !important;
  }

  @media screen and (max-width: 749px) {
    #split-hero-{{ section.id }} .split-hero__heading {
      font-size: clamp(1.9rem, 10vw, 3.4rem);
    }

    #split-hero-{{ section.id }} .split-hero__content {
      width: min(92%, 520px);
    }

    #split-hero-{{ section.id }} .split-hero__button {
      padding: 11px 22px;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById('split-hero-{{ section.id }}');
    if (!section) return;

    const layers = Array.from(section.querySelectorAll('[data-image-layer]'));
    const contents = Array.from(section.querySelectorAll('[data-content]'));
    const panelCount = layers.length;

    if (!panelCount) return;

    const transitionCount = Math.max(panelCount - 1, 1);

    function clamp(value, min, max) {
      return Math.min(Math.max(value, min), max);
    }

    function setActiveContent(index) {
      contents.forEach((content, i) => {
        content.classList.toggle('is-active', i === index);
      });
    }

    function update() {
      const rect = section.getBoundingClientRect();
      const viewportH = window.innerHeight || document.documentElement.clientHeight;
      const scrollable = Math.max(section.offsetHeight - viewportH, 1);

      const progress = clamp(-rect.top / scrollable, 0, 1);

      layers.forEach((layer, index) => {
        if (index === 0) {
          layer.style.clipPath = 'inset(0% 0 0 0)';
          return;
        }

        const start = (index - 1) / transitionCount;
        const end = index / transitionCount;
        const local = clamp((progress - start) / (end - start), 0, 1);
        const revealTop = (1 - local) * 100;

        layer.style.clipPath = `inset(${revealTop}% 0 0 0)`;
      });

      let activeIndex = 0;

      for (let i = 1; i < panelCount; i++) {
        const start = (i - 1) / transitionCount;
        const end = i / transitionCount;
        const local = clamp((progress - start) / (end - start), 0, 1);

        if (local >= 0.6) {
          activeIndex = i;
        }
      }

      setActiveContent(activeIndex);
    }

    update();

    let ticking = false;

    function requestTick() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          update();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', requestTick, { passive: true });
    window.addEventListener('resize', requestTick);
    document.addEventListener('shopify:section:load', requestTick);
    document.addEventListener('shopify:section:reorder', requestTick);
    document.addEventListener('shopify:block:select', requestTick);
  })();
</script>

{% schema %}
{
  "name": "Splithero",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "panel",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Discover"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Online Store"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Split hero",
      "blocks": [
        { "type": "panel" },
        { "type": "panel" },
        { "type": "panel" }
      ]
    }
  ]
}
{% endschema %}
