<section class="editorial-hero" id="editorial-hero-{{ section.id }}">
  {% for block in section.blocks %}
    <div class="editorial-hero__panel" {{ block.shopify_attributes }}>
      <div class="editorial-hero__media">
        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 2400
            | image_tag:
              class: 'editorial-hero__image',
              loading: 'lazy',
              alt: block.settings.heading
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'editorial-hero__image editorial-hero__placeholder' }}
        {% endif %}
      </div>

      <div class="editorial-hero__overlay"></div>

      <div class="editorial-hero__content">
        {% if block.settings.eyebrow != blank %}
          <div class="editorial-hero__eyebrow">
            {{ block.settings.eyebrow }}
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="editorial-hero__heading">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" class="editorial-hero__button">
            {{ block.settings.button_label }}
          </a>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</section>

<style>
  #editorial-hero-{{ section.id }} {
    position: relative;
  }

  #editorial-hero-{{ section.id }} .editorial-hero__panel {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  #editorial-hero-{{ section.id }} .editorial-hero__media,
  #editorial-hero-{{ section.id }} .editorial-hero__image,
  #editorial-hero-{{ section.id }} .editorial-hero__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #editorial-hero-{{ section.id }} .editorial-hero__image,
  #editorial-hero-{{ section.id }} .editorial-hero__placeholder {
    display: block;
    object-fit: cover;
  }

  #editorial-hero-{{ section.id }} .editorial-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.14);
    z-index: 1;
    pointer-events: none;
  }

  #editorial-hero-{{ section.id }} .editorial-hero__content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;

    width: min(90%, 760px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;
  }

  #editorial-hero-{{ section.id }} .editorial-hero__eyebrow,
  #editorial-hero-{{ section.id }} .editorial-hero__heading {
    color: {{ section.settings.text_color }} !important;
  }

  #editorial-hero-{{ section.id }} .editorial-hero__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #editorial-hero-{{ section.id }} .editorial-hero__heading {
    margin: 0;
    font-size: clamp(2.1rem, 5.2vw, 4.3rem);
    line-height: 1;
    font-weight: 400;
    text-align: center;
    max-width: 100%;
  }

  #editorial-hero-{{ section.id }} .editorial-hero__button {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 12px 28px;
    background: transparent;
    border: 1px solid {{ section.settings.text_color }};
    color: {{ section.settings.text_color }} !important;
    text-decoration: none;
    font-size: 0.85rem;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  #editorial-hero-{{ section.id }} .editorial-hero__button:hover {
    background: {{ section.settings.text_color }};
    color: #000000 !important;
  }

  @media screen and (max-width: 749px) {
    #editorial-hero-{{ section.id }} .editorial-hero__content {
      width: min(92%, 520px);
    }

    #editorial-hero-{{ section.id }} .editorial-hero__heading {
      font-size: clamp(1.9rem, 10vw, 3.4rem);
    }

    #editorial-hero-{{ section.id }} .editorial-hero__button {
      padding: 11px 22px;
    }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "panel",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Discover"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Online Store"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "panel"
        },
        {
          "type": "panel"
        },
        {
          "type": "panel"
        }
      ]
    }
  ]
}
{% endschema %}