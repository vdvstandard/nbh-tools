# Shopify store
SHOPIFY_SHOP=your-shop-name.myshopify.com

# App credentials
SHOPIFY_API_KEY=your_app_api_key
SHOPIFY_API_SECRET=your_app_api_secret

# Optional session and admin token values
SHOPIFY_SESSION_TOKEN=
SHOPIFY_TOKEN_TYPE=online
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN_EXPIRES_AT=
SHOPIFY_ADMIN_ACCESS_TOKEN_SCOPE=
SHOPIFY_ADMIN_ACCESS_TOKEN_REFRESHED_AT=

# Brand sync settings
METAFIELD_NAMESPACE=custom
METAFIELD_KEY=brand
SHOPIFY_SCOPES=write_products,write_inventory,read_locations,write_content,write_metaobject_definitions,write_metaobjects,write_publications
SHOPIFY_OAUTH_REDIRECT_URI=http://localhost:3456/callback
METAFIELD_TYPE=single_line_text_field
SHOPIFY_LOCATION_NAME=Neighbourhood Store
