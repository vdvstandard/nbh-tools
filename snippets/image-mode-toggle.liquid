{% comment %}
  Renders the shared Product / Model image mode toggle.

  Accepts:
  - context: {String} Optional context modifier, e.g. 'collection' or 'product'
  - classes: {String} Optional extra classes for the wrapper
{% endcomment %}

{%- liquid
  assign image_mode_toggle_classes = 'image-mode-toggle'
  if context != blank
    assign image_mode_toggle_classes = image_mode_toggle_classes | append: ' image-mode-toggle--' | append: context
  endif
  if classes != blank
    assign image_mode_toggle_classes = image_mode_toggle_classes | append: ' ' | append: classes
  endif
-%}

<div class="{{ image_mode_toggle_classes }}" data-image-mode-toggle role="group" aria-label="Image mode">
  <button
    type="button"
    class="image-mode-toggle__button"
    data-image-mode-option="product"
    aria-pressed="false"
  >
    Product
  </button>
  <button
    type="button"
    class="image-mode-toggle__button"
    data-image-mode-option="model"
    aria-pressed="false"
  >
    Model
  </button>
</div>
